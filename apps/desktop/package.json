{
  "name": "@trace/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Trace.exe — the Trace desktop interface.",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
